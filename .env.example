# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hosted Postgres with pgvector (Supabase or Neon). Use the connection string, with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Models. gemini-2.5-* models are retired on 16 Oct 2026, so use the 3.x family.
CHAT_MODEL=gemini-3.5-flash
EMBED_MODEL=gemini-embedding-001
# Changing EMBED_DIM after ingesting requires re-creating the table (python -m app.ingest --reset)
EMBED_DIM=768

# Retrieval and refusal behaviour (calibrate MIN_SCORE with scripts/eval.py)
TOP_K=6
MIN_SCORE=0.55
HISTORY_TURNS=6

# Safety
MAX_MESSAGE_CHARS=1000
RATE_LIMIT_PER_MIN=20

# Login page shows one-click demo accounts. True is fine for a public demo with fake data; false for real data.
SHOW_DEMO_LOGINS=true

# Admin panel (separate from employee logins). The first start creates this super admin if none exists.
# Use a strong password. Later admins: python -m app.admin_users add <username> <password> --level hr
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Syed Usman Ali
